# Backend API base URL.
# In production the web app and API are served from the same origin, so a
# relative base works. For a separate backend, set the full URL instead,
# e.g. http://192.168.1.5:3000/api (run: node scripts/setup-local.js)
EXPO_PUBLIC_API_BASE_URL=/api

# Optional request timeout in ms
EXPO_PUBLIC_API_TIMEOUT=10000
