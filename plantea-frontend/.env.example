# Supabase (already used by AuthContext)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Backend API base for legacy endpoints used by some screens (plants/orders/scanner).
# For Expo web, your frontend usually runs on http://localhost:3000, so don't use 3000 here.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Optional request timeout in ms
EXPO_PUBLIC_API_TIMEOUT=10000
API_URL=http://localhost:3000/api
