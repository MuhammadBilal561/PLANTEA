# =============================================================
# Plantea Backend — Environment Template
# Copy to `.env` and adjust. Everything is OPTIONAL except the
# JWT secret. The app runs 100% free with zero external services.
# =============================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration — set a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Database — self-contained SQLite (no account, no cost)
# PLANTEA_DB_PATH=/path/to/plantea.db

# Business Configuration (free platform — 0% commission)
DEFAULT_DELIVERY_FEE=0

# PlantNet API (OPTIONAL — free key from https://my-api.plantnet.org)
# When set, the AI scanner adds real species identification.
# Without it, the scanner uses local image analysis + knowledge base.
PLANTNET_API_KEY=

# Email (OPTIONAL — used for forgot-password OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Plantea <noreply@plantea.pk>

# JazzCash (OPTIONAL — app is COD-first and free)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_SANDBOX_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
API_BASE_URL=http://localhost:3000
