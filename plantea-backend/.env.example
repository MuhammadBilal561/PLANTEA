# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration
# Get these from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# JWT Configuration
# Generate a strong random string for production
JWT_SECRET=your-super-secure-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# PlantNet API Configuration
# Get your API key from: https://my-api.plantnet.org
PLANTNET_API_KEY=your-plantnet-api-key-here

# Business Configuration
COMMISSION_FREE_TIER=10.00
COMMISSION_PAID_TIER=5.00
DEFAULT_DELIVERY_FEE=150.00

# Email Configuration (SMTP)
# For Gmail: Enable 2FA and create an App Password
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Plantea <noreply@plantea.pk>

# JazzCash Payment Gateway Configuration
# Get credentials from JazzCash merchant portal
JAZZCASH_MERCHANT_ID=your-merchant-id
JAZZCASH_PASSWORD=your-password
JAZZCASH_INTEGRITY_SALT=your-integrity-salt
JAZZCASH_SANDBOX_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
API_BASE_URL=http://localhost:3000
